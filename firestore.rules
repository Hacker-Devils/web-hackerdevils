rules_version = '2';

// Visitors can only create a Code-A-Thon registration. Nobody can read, change or delete one through the
// website; officers see sign-ups in the Firebase console. Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId}/registrations/{email} {
      allow create: if eventId == 'code-a-thon-fall-2026'
        // Registration closes when the event starts: 2026-11-22 1 PM Arizona time (content/events.ts).
        && request.time < timestamp.value(1795377600000)
        && validRegistration(request.resource.data, email);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function validRegistration(data, email) {
  return data.keys().hasAll(['name', 'email', 'track', 'createdAt'])
    && data.keys().hasOnly(['name', 'email', 'track', 'hackerrank', 'createdAt'])
    && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
    && data.email is string && data.email == email && data.email.matches('^[a-z0-9._%+-]+@asu[.]edu$')
    && data.track in ['beginner', 'advanced']
    && (!('hackerrank' in data) || (data.hackerrank is string && data.hackerrank.size() >= 1 && data.hackerrank.size() <= 40))
    && data.createdAt == request.time;
}
